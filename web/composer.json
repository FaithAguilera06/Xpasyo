{
    "name": "xpasyo/app",
    "description": "Xpasyo Fitness Application",
    "type": "project",
    "require": {
        "php": "^8.0",
        "google/cloud-storage": "^1.25",
        "firebase/php-jwt": "^6.0",
        "monolog/monolog": "^2.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
